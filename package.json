    "@payloadcms/ui": "^3.68.5",
    "graphql": "^16.12.0",
    "keen-slider": "^6.8.6",
    "next": "16.0.10",
    "payload": "^3.68.5",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "resend": "^6.9.3",
    "sharp": "^0.34.5",
    "yet-another-react-lightbox": "^3.29.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "tailwindcss": "^4",
