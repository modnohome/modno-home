{
  "name": "modno-home",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Modno Home — інтернет-вітрина виробника модульних диванів на Next.js 16 і Payload CMS 3",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "generate:importmap": "payload generate:importmap",
